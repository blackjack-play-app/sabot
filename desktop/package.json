{
  "name": "sabot",
  "productName": "Blackjack Play",
  "version": "1.1.0",
  "description": "Blackjack Play — entraîneur de blackjack en 3D (jetons fictifs uniquement)",
  "author": {
    "name": "Blackjack Play",
    "email": "contact@blackjack-play.app"
  },
  "license": "MIT",
  "main": "main.js",
  "homepage": "https://blackjack-play.app",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "app.blackjack-play.sabot",
    "productName": "Blackjack Play",
    "copyright": "Blackjack Play — jetons fictifs, aucun argent réel",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../site",
        "to": "site",
        "filter": [
          "**/*",
          "!downloads/**"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "BlackjackPlay-${version}-Windows-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Blackjack Play",
      "artifactName": "BlackjackPlay-Setup-${version}-${arch}.${ext}",
      "language": "1036",
      "installerLanguages": [
        "fr_FR"
      ],
      "license": "build/license.txt"
    },
    "portable": {
      "artifactName": "BlackjackPlay-${version}-Portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.card-games",
      "artifactName": "BlackjackPlay-${version}-macOS-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "artifactName": "BlackjackPlay-${version}-Linux-${arch}.${ext}",
      "synopsis": "Entraîneur de blackjack en 3D",
      "maintainer": "Blackjack Play",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "deb": {
      "artifactName": "BlackjackPlay-${version}-Linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "blackjack-play-app",
        "repo": "sabot",
        "releaseType": "release"
      }
    ],
    "rpm": {
      "artifactName": "BlackjackPlay-${version}-Linux-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blackjack-play-app/sabot.git"
  }
}